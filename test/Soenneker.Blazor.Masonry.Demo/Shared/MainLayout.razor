@inherits LayoutComponentBase

<div class="container py-4">
    <header class="d-flex flex-wrap align-items-center justify-content-between gap-3 border-bottom pb-3 mb-4">
        <h1 class="h3 mb-0">@DemoTitle</h1>
        <a href="@RepositoryUrl" target="_blank" rel="noreferrer" class="btn btn-primary">GitHub</a>
    </header>
    @Body
</div>

@code {
    private static string DemoTitle => typeof(MainLayout).Assembly.GetName().Name ?? "Soenneker Demo";
    private const string RepositoryUrl = "https://github.com/soenneker/soenneker.blazor.masonry";
}
